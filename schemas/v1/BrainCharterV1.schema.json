{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "boundaries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domainConventions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidencePreferences": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "origin": {
      "type": "string",
      "enum": ["inferred", "owner-specified"]
    }
  },
  "required": [
    "version",
    "description",
    "purpose",
    "boundaries",
    "domainConventions",
    "evidencePreferences",
    "origin"
  ],
  "additionalProperties": false,
  "$id": "https://portable-second-brain.dev/schemas/v1/BrainCharterV1.schema.json",
  "title": "BrainCharterV1"
}
