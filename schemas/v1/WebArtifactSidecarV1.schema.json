            },
            "finalUrl": {
              "type": "string",
              "pattern": "^https?:\\/\\/(?![^/?#\\s]*@)[^/?#\\s]+(?:[/?#].*)?$"
            },
            "redirectChain": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^https?:\\/\\/(?![^/?#\\s]*@)[^/?#\\s]+(?:[/?#].*)?$"
              }
            },
            "retrievedAt": {
              "type": "string",
