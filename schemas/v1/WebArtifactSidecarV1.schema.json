{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brainWebArtifact": {
      "type": "number",
      "const": 1
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "enum": [
        "markdown",
        "text",
        "json",
        "jsonl",
        "csv",
        "tsv",
        "pdf",
        "docx",
        "epub"
      ]
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "discovery": {
      "type": "object",
      "properties": {
        "originalUrl": {
          "type": "string",
          "format": "uri"
        },
        "finalUrl": {
          "type": "string",
          "format": "uri"
        },
        "redirectChain": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "queryId": {
          "type": "string",
          "pattern": "^qry_[a-f0-9]{32}$"
        },
        "questionHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "type": "string",
          "enum": ["text", "artifact"]
        },
        "completeness": {
          "type": "string",
          "enum": ["complete", "partial"]
        },
        "captureKind": {
          "type": "string",
          "enum": ["page", "snippet"]
        }
      },
      "required": [
        "originalUrl",
        "finalUrl",
        "redirectChain",
        "retrievedAt",
        "queryId",
        "questionHash",
        "query",
        "representation",
        "completeness"
      ],
      "additionalProperties": false
    },
    "supersedes": {
      "type": "string",
      "pattern": "^src_[a-f0-9]{16}$"
    }
  },
  "required": [
    "brainWebArtifact",
    "sourcePath",
    "artifactSha256",
    "artifactBytes",
    "title",
    "format",
    "mediaType",
    "discovery"
  ],
  "additionalProperties": false,
  "$id": "https://portable-second-brain.dev/schemas/v1/WebArtifactSidecarV1.schema.json",
  "title": "WebArtifactSidecarV1"
}
