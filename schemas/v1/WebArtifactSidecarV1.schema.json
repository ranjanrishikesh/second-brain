            },
            "queryId": {
              "type": "string",
              "pattern": "^qry_[a-f0-9]{32}$"
            },
            "questionHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "query": {
              "type": "string",
              "minLength": 1
            },
            "representation": {
              "type": "string",
              "enum": ["text", "artifact"]
            },
            "completeness": {
              "type": "string",
              "enum": ["complete", "partial"]
            },
            "captureKind": {
              "type": "string",
              "enum": ["page", "snippet"]
            }
          },
          "required": [
            "originalUrl",
            "finalUrl",
            "redirectChain",
            "retrievedAt",
            "queryId",
            "questionHash",
            "query",
            "representation",
            "completeness"
          ],
