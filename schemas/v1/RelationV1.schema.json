{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "targetId": {
      "type": "string",
      "pattern": "^pg_[a-z0-9_]{3,64}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "anchor": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "sourceIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^src_[a-f0-9]{16}$"
      }
    }
  },
  "required": ["targetId", "kind", "sourceIds"],
  "additionalProperties": false,
  "$id": "https://portable-second-brain.dev/schemas/v1/RelationV1.schema.json",
  "title": "RelationV1"
}
