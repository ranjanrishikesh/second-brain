{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^op_[a-z0-9_-]{3,96}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "apply",
        "query",
        "source-scan",
        "source-supersede",
        "bootstrap",
        "audit",
        "web-capture",
        "identity",
        "charter"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["completed", "unanswered", "partial"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "pageIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tiersUsed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["wiki", "sources", "web"]
      }
    },
    "queryId": {
      "type": "string",
      "pattern": "^qry_[a-f0-9]{32}$"
    },
    "setupId": {
      "type": "string",
      "pattern": "^setup_[a-f0-9]{32}$"
    }
  },
  "required": [
    "version",
    "id",
    "kind",
    "status",
    "startedAt",
    "completedAt",
    "summary",
    "pageIds",
    "tiersUsed"
  ],
  "additionalProperties": false,
  "$id": "https://portable-second-brain.dev/schemas/v1/OperationRecordV1.schema.json",
  "title": "OperationRecordV1"
}
