{
  "name": "portable-second-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "schemas:generate": "tsx scripts/generate-json-schemas.ts && biome format --write schemas",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/e2e",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "brain": "tsx --conditions=source packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/yauzl": "3.4.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-node": "1.29.0",
      "sharp": "0.35.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
